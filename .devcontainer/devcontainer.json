{
	"name": "Introduction to Data Science",
	"image": "ghcr.io/itsleeds/tds",
	"customizations": {
		"vscode": {
			"settings": {
				"r.sessionWatcher": true,
				"r.plot.backend": "auto",
				"r.bracketedPaste": true,
				"r.interactive.executionTarget": "terminal"
			},
			"extensions": [
				"REditorSupport.r",
				"Posit.air-vscode",
				"GitHub.copilot-chat",
				"quarto.quarto",
				"ms-python.python",
				"ms-toolsai.jupyter"
			]
		}
	}
}
