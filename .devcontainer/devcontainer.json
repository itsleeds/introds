{
	"name": "Introduction to Data Science",
	"image": "mcr.microsoft.com/devcontainers/universal:2",
	"features": {
		"ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {},
		"ghcr.io/rocker-org/devcontainer-features/r-apt:1": {
			"vscodeRSupport": "full",
			"installRMarkdown": true
		}
	},
	"postCreateCommand": "pip install --user -r requirements.txt || pip install -r requirements.txt",
	"customizations": {
		"vscode": {
			"settings": {
				"r.sessionWatcher": true,
				"r.plot.backend": "auto",
				"r.bracketedPaste": true,
				"r.interactive.executionTarget": "terminal"
			},
			"extensions": [
				"REditorSupport.r",
				"Posit.air-vscode",
				"GitHub.copilot-chat",
				"quarto.quarto",
				"ms-python.python",
				"ms-toolsai.jupyter"
			]
		}
	}
}
